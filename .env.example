# Host port mappings
BZR_WS_PORT=1337
BZR_UDP_PORT=1338
BZR_RELAY_PORT=1339
BZR_HEALTH_PORT=8080

# Shared relay remains the default. Use the pair-ports Compose overlay for
# 3+ relayed players; it enables pair mode and publishes this entire UDP range.
# The bounds alone do not enable pair mode. 30 ports total across all lobbies.
BZR_RELAY_PAIR_PORTS=0
BZR_RELAY_PAIR_PORT_START=1340
BZR_RELAY_PAIR_PORT_END=1369

# Server behavior
BZR_LOG_LEVEL=INFO
BZR_AUTOSAVE_SECONDS=15
BZR_MAX_LOBBIES=500
BZR_MOTD=Welcome to community-hosted BZR failover server.

# Admin controls
# If Authorization.content.key matches BZR_ADMIN_KEY, session is admin.
BZR_ADMIN_KEY=
# Comma-separated user IDs always treated as admins.
BZR_ADMIN_IDS=

# Status port detail pages (/access, /lobbies, /captures) answer loopback only.
# To read them from the Docker host, allow the bridge network, e.g. 172.16.0.0/12.
BZR_HEALTH_DETAIL_HOSTS=
