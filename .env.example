# Host port mappings
BZR_WS_PORT=1337
BZR_UDP_PORT=1338
BZR_HEALTH_PORT=8080

# Server behavior
BZR_LOG_LEVEL=INFO
BZR_AUTOSAVE_SECONDS=15
BZR_MAX_LOBBIES=500
BZR_MOTD=Welcome to community-hosted BZR failover server.

# Admin controls
# If Authorization.content.key matches BZR_ADMIN_KEY, session is admin.
BZR_ADMIN_KEY=
# Comma-separated user IDs always treated as admins.
BZR_ADMIN_IDS=
